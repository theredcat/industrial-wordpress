{
    "name": "theredcat/industrial-wordpress",
    "type": "project",
    "repositories": [
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        },
        {
            "url": "https://github.com/theredcat/advanced-custom-fields-wpcli.git",
            "type": "git"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psy/psysh" : "0.12.2",
        "johnpbloch/wordpress": "6.9.4",
        "johnpbloch/wordpress-core-installer": "2.0.0",
        "incenteev/composer-parameter-handler": "2.3.0",
        "wp-cli/wp-cli" : "2.12.0",
        "wp-cli/db-command" : "2.1.3",
        "wp-cli/cron-command" : "2.3.2",
        "wp-cli/core-command" : "2.1.23",
        "wp-cli/role-command" : "2.0.16",
        "wp-cli/eval-command" : "2.2.7",
        "wp-cli/media-command" : "2.2.5",
        "wp-cli/import-command" : "2.0.15",
        "wp-cli/doctor-command" : "2.2.0",
        "wp-cli/rewrite-command": "2.0.16",
        "wp-cli/checksum-command" : "2.3.2",
        "wp-cli/language-command" : "2.0.25",
        "wp-cli/extension-command" : "2.1.24",
        "wp-cli/super-admin-command" : "2.0.16",
        "wp-cli/search-replace-command" : "2.1.9",
        "wp-cli/maintenance-mode-command" : "2.1.3",
        "wpackagist-plugin/elasticpress": "5.3.2",
        "wpackagist-plugin/w3-total-cache": "2.9.2",
        "wpackagist-plugin/woocommerce": "10.6.1",
        "wpackagist-plugin/advanced-access-manager": "7.1.0",
        "wpackagist-plugin/wordpress-seo": "27.1.1",
        "wpackagist-plugin/advanced-custom-fields": "6.7.1",
        "hoppinger/advanced-custom-fields-wpcli": "4.0.1",
        "wpackagist-plugin/smtp-mailer": "1.1.25"
    },
    "require-dev": {
        "wpackagist-plugin/wordpress-importer": "0.9.5",
        "wp-cli/profile-command" : "2.1.5",
        "wp-cli/widget-command" : "2.2.0",
        "wp-cli/scaffold-command": "2.5.2"
    },
    "scripts": {
        "post-install-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters"
        ],
        "post-update-cmd": [
            "Incenteev\\ParameterHandler\\ScriptHandler::buildParameters"
        ]
    },
    "extra": {
        "wordpress-install-dir": "wp",
        "installer-paths": {
            "wp/wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
            "wp/wp-content/themes/{$name}/": ["type:wordpress-theme"]
        },
        "incenteev-parameters": {
            "file": "config/parameters.yml",
            "env-map": {
                "locale": "LOCALE",

                "database_wp_host": "DATABASE_WP_HOST",
                "database_wp_port": "DATABASE_WP_PORT",
                "database_wp_name": "DATABASE_WP_NAME",
                "database_wp_user": "DATABASE_WP_USER",
                "database_wp_password": "DATABASE_WP_PASSWORD",

                "aws_key_id": "AWS_KEY_ID",
                "aws_access_key": "AWS_ACCESS_KEY",

                "elasticpress_host": "ELASTICPRESS_HOST",
                "elasticpress_port": "ELASTICPRESS_PORT",
                "elasticpress_index": "ELASTICPRESS_INDEX",
                "elasticpress_index_prefix": "ELASTICPRESS_INDEX_PREFIX",
                "elasticpress_network": "ELASTICPRESS_NETWORK",
                "elasticpress_protocol": "ELASTICPRESS_PROTOCOL",

                "docker_wordpress_title": "WORDPRESS_TITLE",
                "docker_wordpress_username": "WORDPRESS_USERNAME",
                "docker_wordpress_password": "WORDPRESS_PASSWORD",
                "docker_wordpress_email": "WORDPRESS_EMAIL",
                "docker_wordpress_language": "WORDPRESS_LANGUAGE",
                "docker_wordpress_multisite": "WORDPRESS_MULTISITE"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true,
            "composer/installers": true
        }
    }
}
